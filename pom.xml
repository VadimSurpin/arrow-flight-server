<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>pro.surpin.arrowflight</groupId>
    <artifactId>arrow-flight-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <modules>
        <module>flight-server</module>
        <module>flight-client-core</module>
        <module>flight-spark</module>
        <module>flight-starrocks</module>
        <module>flight-trino</module>
    </modules>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <excludedGroups>integration,spark,perf,smoke,real-services</excludedGroups>
        <arrow.version>19.0.0</arrow.version>
        <spark.version>3.5.9</spark.version>
        <junit.version>5.14.4</junit.version>
        <checkstyle.failOnViolation>true</checkstyle.failOnViolation>
        <sonar.projectKey>VadimSurpin_arrow-flight-server</sonar.projectKey>
        <sonar.organization>VadimSurpin</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>flight-server/target/site/jacoco/jacoco.xml,flight-client-core/target/site/jacoco/jacoco.xml,flight-spark/target/site/jacoco/jacoco.xml,flight-trino/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.3.0</version>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>integration</id>
            <properties>
                <groups>integration | spark | smoke</groups>
                <excludedGroups>perf,real-services</excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>perf</id>
            <properties>
                <groups>perf</groups>
                <excludedGroups />
            </properties>
        </profile>
        <profile>
            <id>real-services</id>
            <properties>
                <groups>real-services</groups>
                <excludedGroups />
            </properties>
        </profile>
    </profiles>
</project>
