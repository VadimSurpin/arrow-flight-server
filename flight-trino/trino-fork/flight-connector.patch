     @Override
+    public Optional<AggregationApplicationResult<TableHandle>> applyPartialAggregation(
+            Session session,
+            TableHandle table,
+            List<AggregateFunction> aggregations,
+            Map<String, ColumnHandle> assignments,
+            List<List<ColumnHandle>> groupingSets,
+            List<Type> intermediateTypes)
+    {
+        // Global aggregation is represented by [[]]
+        checkArgument(!groupingSets.isEmpty(), "No grouping sets provided");
+
+        checkArgument(aggregations.size() == intermediateTypes.size(), "Partial aggregation state count mismatch");
+        CatalogHandle catalogHandle = table.catalogHandle();
+        ConnectorMetadata metadata = getMetadata(session, catalogHandle);
+
+        ConnectorSession connectorSession = session.toConnectorSession(catalogHandle);
+        return metadata.applyPartialAggregation(connectorSession, table.connectorHandle(), aggregations, assignments, groupingSets, intermediateTypes)
+                .map(result -> {
+                    verifyProjection(table, result.getProjections(), result.getAssignments(), aggregations.size());
+
+                    for (int i = 0; i < intermediateTypes.size(); i++) {
+                        checkArgument(result.getProjections().get(i).getType().equals(intermediateTypes.get(i)),
+                                "Partial aggregation returned an incompatible state type");
+                    }
+                    return new AggregationApplicationResult<>(
+                            new TableHandle(catalogHandle, result.getHandle(), table.transaction()),
+                            result.getProjections(),
+                            result.getAssignments(),
+                            result.getGroupingColumnMapping(),
+                            result.isPrecalculateStatistics());
+                });
+    }
