+
+import static io.trino.SystemSessionProperties.isAllowPushdownIntoConnectors;
+import static io.trino.matching.Capture.newCapture;
+import static io.trino.metadata.GlobalFunctionCatalog.isBuiltinFunctionName;
+import static io.trino.sql.planner.plan.AggregationNode.Step.FINAL;
+import static io.trino.sql.planner.plan.AggregationNode.Step.PARTIAL;
+import static io.trino.sql.planner.plan.AggregationNode.Step.SINGLE;
+import static io.trino.sql.planner.plan.Patterns.aggregation;
+import static io.trino.sql.planner.plan.Patterns.source;
+import static io.trino.sql.planner.plan.Patterns.tableScan;
+import static java.util.Objects.requireNonNull;
+
+/** Replaces supported aggregations with connector-produced intermediate states. */
+public final class PushPartialAggregationIntoTableScan
+        implements Rule<AggregationNode>
+{
+    private static final Capture<TableScanNode> TABLE_SCAN = newCapture();
+    private static final Pattern<AggregationNode> PATTERN = aggregation()
+            .matching(node -> node.getStep() == PARTIAL || node.getStep() == SINGLE)
+            .with(source().matching(tableScan().capturedAs(TABLE_SCAN)));
+
+    private final PlannerContext plannerContext;
+
+    /**
+     * Creates the partial pushdown rule.
+     *
+     * @param plannerContext planner services
+     */
+    public PushPartialAggregationIntoTableScan(PlannerContext plannerContext)
+    {
+        this.plannerContext = requireNonNull(plannerContext, "plannerContext is null");
+    }
+
+    @Override
+    public Pattern<AggregationNode> getPattern()
+    {
+        return PATTERN;
+    }
+
+    @Override
+    public boolean isEnabled(Session session)
+    {
+        return isAllowPushdownIntoConnectors(session);
+    }
+
+    @Override
+    public Result apply(AggregationNode node, Captures captures, Context context)
+    {
+        if (node.getAggregations().isEmpty() || node.getGroupingSets().getGroupingSetCount() != 1 ||
+                node.getHashSymbol().isPresent() || node.getGroupIdSymbol().isPresent() ||
+                !node.isDecomposable(context.getSession(), plannerContext.getMetadata()) ||
+                node.getAggregations().values().stream().anyMatch(aggregation ->
+                        !isBuiltinFunctionName(aggregation.getResolvedFunction().signature().getName()) ||
+                                aggregation.isDistinct() || aggregation.getFilter().isPresent() ||
+                                aggregation.getMask().isPresent() || aggregation.getOrderingScheme().isPresent() ||
+                                aggregation.getArguments().stream().anyMatch(argument -> !(argument instanceof Reference)))) {
+            return Result.empty();
+        }
+
+        TableScanNode scan = captures.get(TABLE_SCAN);
+        Map<String, ColumnHandle> inputs = new HashMap<>();
+        scan.getAssignments().forEach((symbol, column) -> inputs.put(symbol.name(), column));
+        List<Map.Entry<Symbol, AggregationNode.Aggregation>> entries = List.copyOf(node.getAggregations().entrySet());
+        ImmutableList.Builder<Type> stateTypes = ImmutableList.builder();
+        ImmutableList.Builder<AggregateFunction> functions = ImmutableList.builder();
+        for (var entry : entries) {
+            var aggregation = entry.getValue();
+            var signature = aggregation.getResolvedFunction().signature();
+            List<Type> intermediateTypes = plannerContext.getMetadata()
+                    .getAggregationFunctionMetadata(context.getSession(), aggregation.getResolvedFunction())
+                    .getIntermediateTypes().stream().map(plannerContext.getTypeManager()::getType).toList();
+            if (intermediateTypes.isEmpty()) {
+                return Result.empty();
+            }
+            Type stateType = intermediateTypes.size() == 1 ? intermediateTypes.getFirst() : RowType.anonymous(intermediateTypes);
+            if (node.getStep() == PARTIAL && !entry.getKey().type().equals(stateType)) {
+                return Result.empty();
+            }
+            stateTypes.add(stateType);
+            functions.add(new AggregateFunction(signature.getName().getFunctionName(), signature.getReturnType(),
+                    aggregation.getArguments().stream().map(Reference.class::cast)
+                            .map(argument -> (io.trino.spi.expression.ConnectorExpression) new Variable(argument.name(), argument.type())).toList(),
+                    List.of(), false, Optional.empty()));
+        }
+        List<Type> types = stateTypes.build();
+        var result = plannerContext.getMetadata().applyPartialAggregation(context.getSession(), scan.getTable(),
+                functions.build(), inputs,
+                List.of(node.getGroupingKeys().stream().map(scan.getAssignments()::get).toList()), types);
+        if (result.isEmpty()) {
+            return Result.empty();
+        }
+        if (!result.orElseThrow().getHandle().connectorHandle().producesPartialAggregation()) {
+            throw new IllegalStateException("Partial aggregation scan must declare its intermediate states");
+        }
+
+        ImmutableList.Builder<Symbol> scanOutputs = ImmutableList.builder();
+        ImmutableMap.Builder<Symbol, ColumnHandle> scanAssignments = ImmutableMap.builder();
+        Map<ColumnHandle, Symbol> columnSymbols = new HashMap<>();
+        Map<String, Symbol> variables = new HashMap<>();
+        for (Assignment assignment : result.orElseThrow().getAssignments()) {
+            Symbol symbol = context.getSymbolAllocator().newSymbol(assignment.getVariable(), assignment.getType());
+            scanOutputs.add(symbol);
+            scanAssignments.put(symbol, assignment.getColumn());
+            columnSymbols.put(assignment.getColumn(), symbol);
+            variables.put(assignment.getVariable(), symbol);
+        }
+
+        Assignments.Builder projections = Assignments.builder();
+        for (Symbol group : node.getGroupingKeys()) {
+            ColumnHandle column = scan.getAssignments().get(group);
+            ColumnHandle mapped = result.orElseThrow().getGroupingColumnMapping().getOrDefault(column, column);
+            Symbol output = columnSymbols.get(mapped);
+            if (output == null || !output.type().equals(group.type())) {
+                throw new IllegalStateException("Partial aggregation did not return a grouping column: " + group);
+            }
+            projections.put(group, output.toSymbolReference());
+        }
+        ImmutableMap.Builder<Symbol, AggregationNode.Aggregation> finalAggregations = ImmutableMap.builder();
+        for (int i = 0; i < entries.size(); i++) {
+            var entry = entries.get(i);
+            Symbol state = node.getStep() == PARTIAL ? entry.getKey() : context.getSymbolAllocator().newSymbol("partial_state", types.get(i));
+            var expression = ConnectorExpressionTranslator.translate(context.getSession(), result.orElseThrow().getProjections().get(i), plannerContext, variables);
+            if (!expression.type().equals(types.get(i))) {
+                throw new IllegalStateException("Partial aggregation returned an incompatible state type");
+            }
+            projections.put(state, expression);
+            finalAggregations.put(entry.getKey(), new AggregationNode.Aggregation(entry.getValue().getResolvedFunction(),
+                    List.of(state.toSymbolReference()), false, Optional.empty(), Optional.empty(), Optional.empty()));
+        }
+        PlanNode pushed = new ProjectNode(context.getIdAllocator().getNextId(),
+                new TableScanNode(context.getIdAllocator().getNextId(), result.orElseThrow().getHandle(),
+                        scanOutputs.build(), scanAssignments.buildOrThrow(), TupleDomain.all(), Optional.empty(), scan.isUpdateTarget(), Optional.of(false)),
+                projections.build());
+        if (node.getStep() == PARTIAL) {
+            return Result.ofPlanNode(pushed);
+        }
+        return Result.ofPlanNode(new AggregationNode(node.getId(), pushed, finalAggregations.buildOrThrow(),
+                node.getGroupingSets(), List.of(), FINAL, Optional.empty(), Optional.empty()));
+    }
+}
