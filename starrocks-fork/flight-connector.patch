diff --git a/fe/fe-core/src/test/java/com/starrocks/sql/optimizer/operator/logical/LogicalJDBCScanOperatorFlightAggregationTest.java b/fe/fe-core/src/test/java/com/starrocks/sql/optimizer/operator/logical/LogicalJDBCScanOperatorFlightAggregationTest.java
