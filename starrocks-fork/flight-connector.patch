+        Map<ColumnRefOperator, CallOperator> aggs = Map.of(out, call(FunctionSet.COUNT, Type.BIGINT, false));
+        Assertions.assertTrue(run(aggOver(scan(Map.of("flight.aggregation_pushdown", "false"), null, -1),
